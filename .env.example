# Скопируйте в .env и подставьте свой ключ. Файл .env в репозиторий не коммитится.
# Для OpenRouter (OpenAI-совместимый API):
LLM_API_KEY=sk-or-v1-...ваш_ключ...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Альтернатива — Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Без ключа бот работает на детерминированных шаблонах (LLM не обязательна).
PORT=8000
